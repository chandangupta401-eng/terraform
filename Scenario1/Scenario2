# var.tf
variable "vms" {}
# terraform.tfvars


vms = {
    vm1 = {
        nic = "nic1"
        public = "public1"
        NSGA = "NSGA1"
        subnet = "web"
    }
    vm2 = {
        nic = "nic2"
        public = "public12"
        NSGA = "NSGA2"
        subnet = "web"
    }
    vm3 = {
        nic = "nic3"
        public = "public3"
        NSGA = "NSGA3"
        subnet = "app"
    
    }

}
